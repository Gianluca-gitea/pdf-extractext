APP_NAME=PDF Extractext API
APP_LOG_LEVEL=INFO
APP_MAX_PDF_SIZE_BYTES=10485760
APP_OCR_ENABLED=false
APP_EXTRACT_WORKERS=1
APP_MAX_PENDING_EXTRACTIONS=100
PORT=8000

# MongoDB Configuration
# Para Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pdf-extractext
MONGO_COLLECTION_NAME=documents

# GUI
API_URL=http://127.0.0.1:8000
