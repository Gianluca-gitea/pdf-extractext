APP_LOG_LEVEL=INFO
APP_MAX_PDF_SIZE_BYTES=10485760
PORT=8000

# Servicio extract (services/extract)
APP_OCR_ENABLED=false
APP_EXTRACT_WORKERS=1
APP_MAX_PENDING_EXTRACTIONS=100

# Servicio documents (services/documents)
# Para Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pdf-extractext
MONGO_COLLECTION_NAME=documents
EXTRACT_SERVICE_URL=http://127.0.0.1:8001
EXTRACT_TIMEOUT_S=30

# GUI: con Docker alcanza con API_URL (gateway); sin Docker, una URL por servicio
API_URL=http://127.0.0.1:8000
EXTRACT_API_URL=http://127.0.0.1:8001
DOCUMENTS_API_URL=http://127.0.0.1:8002
