log_format upstream '$remote_addr "$request" $status upstream=$upstream_addr time=$request_time';

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

upstream extract {
    zone extract 64k;
    least_conn;
    server extract:8000 resolve;
    keepalive 32;
    keepalive_timeout 4s;
}

upstream documents {
    zone documents 64k;
    least_conn;
    server documents:8000 resolve;
    keepalive 16;
    keepalive_timeout 4s;
}

server {
    listen 80;
    access_log /dev/stdout upstream;
    client_max_body_size 11m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_request_buffering off;
    proxy_read_timeout 60s;

    location /extract {
        proxy_pass http://extract;
    }

    location /documents {
        proxy_pass http://documents;
    }

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        default_type application/json;
        return 404 '{"detail":"Not Found"}';
    }
}
